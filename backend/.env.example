# Exemple local avec Postgres (docker compose). Ne pas y mettre un secret de production.
PORT=8080
SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/academiablanc
SPRING_DATASOURCE_USERNAME=academiablanc
SPRING_DATASOURCE_PASSWORD=academiablanc
# Render peut injecter DATABASE_URL=postgres://user:pass@host:port/db
# L'API le convertit en JDBC lorsque SPRING_DATASOURCE_URL est absent.
DATABASE_URL=postgres://academiablanc:academiablanc@localhost:5432/academiablanc
JWT_SECRET=remplacer-par-une-chaine-secrete-d-au-moins-32-caracteres
# Propriétaire du logiciel (SUPER_ADMIN). Le compte est créé au démarrage s'il n'existe pas,
# sans inscription ni établissement. Vide : aucun propriétaire de la plateforme.
SUPER_ADMIN_EMAIL=proprietaire@exemple.tg
# Mot de passe initial (ou nouveau mot de passe pour réinitialiser l'accès). Placeholder uniquement :
# ne jamais committer la vraie valeur.
SUPER_ADMIN_PASSWORD=changez-moi
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
